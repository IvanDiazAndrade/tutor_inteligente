# Copiar a .env y completar. El archivo .env nunca se sube al repositorio.
DATABASE_URL=postgresql+psycopg://tutor:tutor@127.0.0.1:5432/tutor
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio

# LLM (docs/configurar_llm.md). Sin clave, el tutor usa sus mensajes locales (modo degradado).
OPENAI_API_KEY=
# Snapshot exacto del modelo (el que muestra la consola de OpenAI), no solo el alias.
LLM_MODELO=gpt-5.4-nano
# Poner false si el modelo rechaza el parámetro temperature (modelos de razonamiento).
LLM_USAR_TEMPERATURA=true
# Tope mensual en dólares: alerta al 80 %, modo local al 100 %.
LLM_TOPE_USD=5
# Precios por millón de tokens: verificarlos en la página de precios de OpenAI.
LLM_PRECIO_ENTRADA_USD_MTOK=0.20
LLM_PRECIO_SALIDA_USD_MTOK=1.25
